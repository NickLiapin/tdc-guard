<tdc version="0.1">
  <!-- БОГАТЫЙ МИР. Две принципиальные перемены против прежнего конфига.

       1. Нападение стало ПРОЦЕССОМ, а не подбрасыванием монеты на каждое
          событие. У машины есть момент начала, и дальше идут стадии:
          закрепление (тихо, единичные события) -> сбор учёток (много отказов)
          -> распространение (вширь) -> выход на серверы. Прежний мир порождал
          сразу третью стадию и никогда первую - отсюда и была слепота к
          разбавленным окнам.

       2. Норма собрана из МНОГИХ законных механизмов, а не из трёх. Именно на
          их пересечении и рождаются совпадения - нормальные окна, случайно
          несущие подпись чужого. Их нельзя нарисовать напрямую, но они
          возникают сами, когда законных явлений достаточно много.

       Роли: 0 станция, 2 новая машина, 3 под чужими учётками,
             4 новая И под чужими, 5 администратор на обходе,
             6 терминальный сервер (много людей законно),
             7 служба со сломанным паролем (сплошные отказы),
             8 разовое обслуживание (всплеск чужих учёток, но законный). -->

  <env count="4000000" seed="world-storm-1">

    <pool name="Work" count="2000">
      <sequence name="hid"><gen type="increment" value="1"/></sequence>
      <sequence name="role">
        <gen type="text" value="0,2,3,4" percent="78.8,0.6,20,0.6"/>
      </sequence>

      <sequence name="userBase"><gen type="formula" expr="hid * 30"/></sequence>
      <!-- Бытовые свойства машины НЕЗАВИСИМЫ друг от друга: одна и та же
           машина может быть и терминальной, и с поломанной службой, и на
           обслуживании. Именно на СОВПАДЕНИИ независимых механизмов и рождаются
           окна, неотличимые от чужой активности. Взаимоисключающие роли такое
           запрещали по построению - это и была ошибка прошлой попытки. -->
      <sequence name="isTerm"><gen type="text" value="1,0" percent="7,93"/></sequence>
      <sequence name="isBrok"><gen type="text" value="1,0" percent="7,93"/></sequence>
      <sequence name="isMaint"><gen type="text" value="1,0" percent="6,94"/></sequence>
      <sequence name="isAdm"><gen type="text" value="1,0" percent="4,96"/></sequence>
      <!-- ШТОРМ. Служба со сломанным паролем, которая долбит без остановки:
           один-два пользователя, несколько назначений, 90-100% отказов,
           сотни событий в час. В LANL таких 3-13 окон в сутки, метка норма.
           Прежние миры их не содержали, и сети принимали шторм за нападение. -->
      <sequence name="isStorm"><gen type="text" value="1,0" percent="1.5,98.5"/></sequence>
      <!-- СОВПАДЕНИЕ. Машина, у которой законно сходятся обе половины подписи
           компрометации: много новых учёток И много отказов. Физически это
           обход после смены паролей - учётки для этой машины новые, часть
           входов отваливается по устаревшим данным. Чужих учёток нет,
           метка остаётся нормой, и это правда, а не подтасовка.
           Доля задаётся строкой COIN_PCT и меняется от мира к миру. -->
      <sequence name="isCoin"><gen type="text" value="1,0" percent="1.5,98.5"/></sequence>
      <sequence name="coinFailMil"><gen type="number" value="150..600"/></sequence>
      <sequence name="coinHour"><gen type="number" value="8..21"/></sequence>
      <sequence name="userSpan">
        <gen if="isStorm == 1" type="number" value="1..2"/>
        <gen if="isTerm == 1" type="number" value="40..160"/>
        <gen type="number" value="1..4"/>
      </sequence>
      <sequence name="dstBase"><gen type="number" value="1..4500"/></sequence>
      <sequence name="dstSpan">
        <gen if="isTerm == 1" type="number" value="20..80"/>
        <gen type="number" value="2..9"/>
      </sequence>

      <sequence name="isQuiet"><gen type="text" value="1,0" percent="18,82"/></sequence>
      <sequence name="spread">
        <gen if="isStorm == 1" type="number" value="1..4"/>
        <gen if="isQuiet == 1" type="number" value="80..260"/>
        <gen type="number" value="1..40"/>
      </sequence>
      <sequence name="churnMil"><gen type="number" value="0..8"/></sequence>

      <!-- когда начинается активность и как широко расходится -->
      <sequence name="atkOffMil"><gen type="number" value="0..700"/></sequence>
      <sequence name="fgBase"><gen type="number" value="1..2000"/></sequence>
      <sequence name="fgSpan"><gen type="number" value="6..60"/></sequence>
      <sequence name="fgDstBase"><gen type="number" value="1..4900"/></sequence>
      <sequence name="fgDstSpan"><gen type="number" value="2..70"/></sequence>

      <sequence name="failMil"><gen type="number" value="20..700"/></sequence>
      <sequence name="baseMil">
        <gen if="isStorm == 1" type="number" value="900..1000"/>
        <gen if="isBrok == 1" type="number" value="300..800"/>
        <gen type="number" value="1..30"/>
      </sequence>
      <!-- час разового обслуживания -->
      <sequence name="burstHour"><gen type="number" value="8..21"/></sequence>
    </pool>

    <pool name="Serv" count="40">
      <sequence name="sid"><gen type="increment" value="1"/></sequence>
      <sequence name="userBase"><gen type="number" value="1..7000"/></sequence>
      <sequence name="userSpan"><gen type="number" value="60..280"/></sequence>
      <sequence name="dstBase"><gen type="number" value="1..3000"/></sequence>
      <sequence name="dstSpan"><gen type="number" value="40..400"/></sequence>
      <sequence name="spread"><gen type="number" value="15..22"/></sequence>
      <sequence name="baseMil"><gen type="number" value="1..30"/></sequence>
    </pool>

    <sequence name="W"><gen type="pool" value="Work"/></sequence>
    <sequence name="S"><gen type="pool" value="Serv"/></sequence>
    <sequence name="N"><gen type="increment" value="1"/></sequence>

    <sequence name="IsServ"><gen type="formula" expr="hash(N, 10) < 0.35 ? 1 : 0"/></sequence>
    <sequence name="IsSvc"><gen type="formula" expr="hash(N, 12) < 0.30 ? 1 : 0"/></sequence>

    <sequence name="Host"><gen type="formula" expr="IsServ == 1 ? 9000 + S.sid : W.hid"/></sequence>
    <sequence name="Role"><gen type="formula" expr="IsServ == 1 ? 1 : W.role"/></sequence>
    <sequence name="Spread"><gen type="formula" expr="IsServ == 1 ? S.spread : W.spread"/></sequence>

    <sequence name="Period">
      <gen type="formula" expr="Role == 2 || Role == 4 ? 1 : (hash(N, 6) < 0.60 ? 0 : 1)"/>
    </sequence>

    <sequence name="Time">
      <gen type="formula"
           expr="Period == 0 ? floor(hash(N, 5) * 28800) : 28800 + floor(hash(N, 3) * Spread) * 3600 + floor(hash(N, 4) * 3600)"/>
    </sequence>

    <!-- СТАДИЯ. До начала: -1. Дальше по три часа на стадию, всего четыре. -->
    <sequence name="AtkStart"><gen type="formula" expr="28800 + W.atkOffMil / 1000 * 39600"/></sequence>
    <sequence name="Stage">
      <gen type="formula"
           expr="Time < AtkStart ? 0 - 1 : min(3, floor((Time - AtkStart) / 10800))"/>
    </sequence>

    <!-- Доля чужих событий растёт со стадией: сперва почти незаметно. -->
    <sequence name="FgRate">
      <gen type="formula"
           expr="Stage < 0 ? 0 : 1.0"/>
    </sequence>

    <sequence name="Foreign">
      <gen type="formula"
           expr="(Role == 3 || Role == 4) && Period == 1 && hash(N, 11) < FgRate ? 1 : 0"/>
    </sequence>

    <!-- Охват учёток тоже растёт со стадией: сперва пробуют единицы. -->
    <sequence name="FgWidth">
      <gen type="formula" expr="2 + max(0, Stage) * (W.fgSpan / 3)"/>
    </sequence>

    <!-- Разовое обслуживание: законный всплеск в один час. -->
    <sequence name="CoinWin">
      <gen type="formula"
           expr="W.isCoin == 1 && Period == 1 && floor(Time / 3600) == W.coinHour ? 1 : 0"/>
    </sequence>

    <sequence name="Burst">
      <gen type="formula"
           expr="W.isMaint == 1 && Period == 1 && floor(Time / 3600) == W.burstHour ? 1 : 0"/>
    </sequence>

    <sequence name="Churn">
      <gen type="formula"
           expr="Foreign == 0 && IsSvc == 0 && (CoinWin == 1 ? hash(N, 14) < 0.95 : (Burst == 1 ? hash(N, 14) < 0.7 : (W.isAdm == 1 ? hash(N, 14) < 0.6 : hash(N, 14) < W.churnMil / 10000))) ? 1 : 0"/>
    </sequence>

    <sequence name="UserBase"><gen type="formula" expr="IsServ == 1 ? S.userBase : W.userBase"/></sequence>
    <sequence name="UserSpan"><gen type="formula" expr="IsServ == 1 ? S.userSpan : W.userSpan"/></sequence>
    <sequence name="DstBase"><gen type="formula" expr="IsServ == 1 ? S.dstBase : W.dstBase"/></sequence>
    <sequence name="DstSpan"><gen type="formula" expr="IsServ == 1 ? S.dstSpan : W.dstSpan"/></sequence>

    <sequence name="User">
      <gen type="formula"
           expr="Foreign == 1 ? ((W.fgBase + floor(hash(N, 1) * FgWidth)) % 2000) * 30 + floor(hash(N, 18) * 2) : (IsSvc == 1 ? (hash(N, 13) < 0.25 ? 9500 + floor(hash(N, 1) * 20) : 9000 + (Host * 7 + floor(hash(N, 1) * 6)) % 400) : (Churn == 1 ? (hash(N, 17) < (W.isAdm == 1 || Burst == 1 || CoinWin == 1 ? 0.05 : 0.5) ? 20000 + floor(hash(N, 15) * 900) : (floor(hash(N, 15) * 2000)) * 30 + floor(hash(N, 19) * 4)) : UserBase + floor(hash(N, 1) * UserSpan)))"/>
    </sequence>

    <!-- На поздних стадиях цели смещаются к серверам. -->
    <sequence name="Dst">
      <gen type="formula"
           expr="Foreign == 1 ? (Stage >= 2 && hash(N, 20) < 0.35 ? 4901 + floor(hash(N, 2) * 10) : 1 + (W.fgDstBase + floor(hash(N, 2) * W.fgDstSpan)) % 4900) : (Churn == 1 ? DstBase + DstSpan + floor(hash(N, 16) * 50) : DstBase + floor(hash(N, 2) * DstSpan))"/>
    </sequence>

    <!-- Отказы: больше всего на стадии сбора учёток, потом спадают. -->
    <sequence name="StageFail">
      <gen type="formula" expr="Stage <= 1 ? 1.6 : (Stage == 2 ? 1.0 : 0.6)"/>
    </sequence>

    <sequence name="FailCut">
      <gen type="formula"
           expr="Foreign == 1 ? min(0.95, W.failMil / 1000 * StageFail) : (CoinWin == 1 ? W.coinFailMil / 1000 : (IsServ == 1 ? S.baseMil : W.baseMil) / 1000)"/>
    </sequence>

    <sequence name="Ok">
      <gen if="hash(N, 8) < FailCut" type="text" value="Fail"/>
      <gen type="text" value="Success"/>
    </sequence>
  </env>

  <block>
    <line><data>${{Time}},U${{User}},C${{Host}},D${{Dst}},${{Ok}},${{Foreign}}</data></line>
  </block>
</tdc>
